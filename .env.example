# Mailgun Configuration for Netlify Functions (Serverless Backend)
# Copy this file to .env and fill in your actual credentials.

# Your Mailgun Private API key (starts with 'key-')
MAILGUN_API_KEY=

# Your Mailgun Domain (e.g. sandbox12345.mailgun.org or your custom domain)
MAILGUN_DOMAIN=

# (Optional) Destination email to receive contact messages.
# Defaults to kaushal.d.ganatra@gmail.com if not specified.
CONTACT_RECEIVER_EMAIL=kaushalganatra.dev@gmail.com
